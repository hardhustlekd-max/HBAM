# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# HBAM - Municipal Permit & Vehicle Management System
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-ONLY ENVIRONMENT VARIABLES & SECRETS (Never exposed to browser)
# ------------------------------------------------------------------------------

# Production Node Environment & Host Port Settings
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Gemini AI Service Key (Server-Only Secret - Used for AI OCR and Document Audits)
# Do NOT prefix with VITE_ to keep it completely hidden from client browser bundles
GEMINI_API_KEY=

# Optional MySQL Database Connection Settings (For hosting platforms with MySQL/MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=hbams_user
DB_PASSWORD=
DB_NAME=hbams_db

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE EXPOSED VARIABLES (Vite Frontend Bundle - Prefixed with VITE_)
# ------------------------------------------------------------------------------

# Firebase Client Configuration Variables (Client-Safe)
VITE_FIREBASE_PROJECT_ID=automated-abbey-dzp2g
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=permit
VITE_FIREBASE_STORAGE_BUCKET=automated-abbey-dzp2g.firebasestorage.app

# GoDaddy / Custom Database Configuration (Client-Safe Fallbacks)
VITE_DB_HOST=localhost
VITE_DB_PORT=3306
VITE_DB_USER=hbams_user
VITE_DB_PASSWORD=
VITE_DB_NAME=hbams_db

